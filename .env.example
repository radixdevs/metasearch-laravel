APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=null
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MetaSearch API credentials, one per catalogue.
#
# THE TOKEN IS THE CATALOGUE: the API infers the TLD bundle and the hero TLD
# from the credential and takes no catalogue parameter, so this app holds three
# in order to show all three. A partner integration has one token and one
# catalogue.
#
# Server-side only. These are never sent to the browser — that is the entire
# reason this app has a backend rather than being a static page.
#
# With none of them set the app serves, but every search returns
# server_misconfigured. There is no sample-data mode here; the static build in
# the Next.js repo is what covers that case.
# ---------------------------------------------------------------------------
METASEARCH_TOKEN_RADIX=
METASEARCH_TOKEN_CLASSICS=
METASEARCH_TOKEN_FULLCAT=

# Searches per minute per IP. THIS IS THE ONLY THING PROTECTING THE ENDPOINT:
# the demo is public by design, so anyone with the URL can search through it and
# every search spends Radix quota under our credential. The credential itself
# never reaches the browser, which is the part that matters; this bounds the
# rate at which a stranger can use it.
#
# Tuned for someone flipping switches while reading results, which is bursty —
# and the page issues two requests per search when AI suggestions are on,
# because those are fetched separately so they cannot block the main results.
METASEARCH_RATE_LIMIT=20

# Upstream call ceiling, seconds. AI suggestions take 8-17s on a cache miss, so
# anything under about 20 kills them mid-flight and it looks like an API fault.
METASEARCH_TIMEOUT=25
